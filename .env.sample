# プロジェクト名
PROJECT_NAME=programming-process-evaluator

# ローカルホストに公開するポート番号
DB_PORT=3307
APP_PORT=8080
# Separate host-only browser sessions for local student and teacher portals.
STUDENT_PORTAL_HOST=student.localhost
TEACHER_PORTAL_HOST=teacher.localhost
# For production, set these to student.ppeval.net and teacher.ppeval.net.

# ローカル開発用の値。共有環境・本番環境では使用しないこと。
DB_NAME=programming_process_evaluator
DB_USER=app
DB_PASSWORD=local-app-password
DB_ROOT_PASSWORD=local-root-password

# Optional: local Gemini API key. Keep the value in the ignored .env only.
# AI evaluations are recorded as failed when this key is missing.
GEMINI_API_KEY=

# Base64-encoded 32-byte AES key for teacher-readable student credentials.
# Generate once with openssl rand -base64 32; store only in ignored .env.
# Keep this key when restarting or restoring the database.
STUDENT_CREDENTIAL_KEY=
