# Private systemd EnvironmentFile; no AWS credentials or age private key.
PPE_PROJECT=ppe-production
PPE_RELEASE=0e2bfae5e23bc512f0b7cf844264d4d45a484ecc
PPE_DB_RELEASE=0e2bfae5e23bc512f0b7cf844264d4d45a484ecc
PPE_DB_SOURCE_DIR=/var/lib/ppe/releases/0e2bfae5e23bc512f0b7cf844264d4d45a484ecc/source
PPE_COMPOSE_FILE=/var/lib/ppe/releases/0e2bfae5e23bc512f0b7cf844264d4d45a484ecc/source/compose.production.yml
PPE_BACKUP_IMAGE=ppe-backup:0e2bfae5e23bc512f0b7cf844264d4d45a484ecc
PPE_SECRETS_DIR=/var/lib/ppe/secrets/release-0e2bfae5e23bc512f0b7cf844264d4d45a484ecc
PPE_STATE_DIR=/var/lib/ppe/state
PPE_BACKUP_DIR=/var/lib/ppe/backups
PPE_BACKUP_PARAMETER_PREFIX=/programming-process-evaluator/prod/backup
PPE_BACKUP_MIN_FREE_MIB=1024
PPE_BACKUP_MAX_AGE_SECONDS=93600
AWS_REGION=ap-northeast-1
