{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "BackupParametersOnly",
      "Effect": "Allow",
      "Action": "ssm:GetParameter",
      "Resource": [
        "arn:aws:ssm:ap-northeast-1:ACCOUNT_ID:parameter/programming-process-evaluator/prod/backup/s3-bucket",
        "arn:aws:ssm:ap-northeast-1:ACCOUNT_ID:parameter/programming-process-evaluator/prod/backup/s3-prefix",
        "arn:aws:ssm:ap-northeast-1:ACCOUNT_ID:parameter/programming-process-evaluator/prod/backup/age-recipient",
        "arn:aws:ssm:ap-northeast-1:ACCOUNT_ID:parameter/programming-process-evaluator/prod/backup/kms-key-arn",
        "arn:aws:ssm:ap-northeast-1:ACCOUNT_ID:parameter/programming-process-evaluator/prod/backup/sns-topic-arn"
      ]
    },
    {
      "Sid": "VersionedBackupPutAndVerify",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObjectVersion"],
      "Resource": "arn:aws:s3:::BUCKET_NAME/production/mysql/*"
    },
    {
      "Sid": "NeverDeleteRecoveryPoints",
      "Effect": "Deny",
      "Action": ["s3:DeleteObject", "s3:DeleteObjectVersion"],
      "Resource": "arn:aws:s3:::BUCKET_NAME/production/mysql/*"
    },
    {
      "Sid": "BackupKmsDataKey",
      "Effect": "Allow",
      "Action": ["kms:GenerateDataKey", "kms:Decrypt"],
      "Resource": "arn:aws:kms:ap-northeast-1:ACCOUNT_ID:key/KEY_ID",
      "Condition": {
        "StringEquals": {"kms:ViaService": "s3.ap-northeast-1.amazonaws.com"},
        "StringLike": {"kms:EncryptionContext:aws:s3:arn": "arn:aws:s3:::BUCKET_NAME/production/mysql/*"}
      }
    },
    {
      "Sid": "FailureNotificationOnly",
      "Effect": "Allow",
      "Action": "sns:Publish",
      "Resource": "arn:aws:sns:ap-northeast-1:ACCOUNT_ID:TOPIC_NAME"
    },
    {
      "Sid": "BackupHealthMetricsOnly",
      "Effect": "Allow",
      "Action": "cloudwatch:PutMetricData",
      "Resource": "*",
      "Condition": {"StringEquals": {"cloudwatch:namespace": "PPE/Backup"}}
    }
  ]
}
