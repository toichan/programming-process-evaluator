@startuml
title Slice 4: AI連携・同意・ログ管理クラス図
caption 同意、認証、監査、AI評価のリクエスト/応答状態を履歴として保存するモデル

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam roundcorner 15
skinparam linetype ortho
skinparam packageStyle rectangle

class User {
  + userId: Long <<PK>>
  + userType: UserType
  + accountStatus: AccountStatus
}

class ConsentRecord {
  + consentId: Long <<PK>>
  + userId: Long <<FK>>
  + consentStatus: ConsentStatus
  + consentDocumentVersionId: Long <<FK>>
  + consentedAt: DateTime
  + withdrawnAt: DateTime
  + updatedAt: DateTime
}

class ConsentDocumentVersion {
  + consentDocumentVersionId: Long <<PK>>
  + versionCode: String
  + title: String
  + body: LongText
  + documentStatus: DocumentStatus
  + effectiveAt: DateTime
  + createdByUserId: Long <<FK>>
  + createdAt: DateTime
}

class LoginHistory {
  + loginHistoryId: Long <<PK>>
  + userId: Long <<FK>>
  + attemptedLoginId: String
  + operationType: LoginOperationType
  + resultStatus: OperationResult
  + errorCode: String
  + errorMessage: Text
  + ipAddress: String
  + userAgent: String
  + sessionId: String
  + errorDetail: Text
  + occurredAt: DateTime
}

class CredentialHistory {
  + credentialHistoryId: Long <<PK>>
  + targetUserId: Long <<FK>>
  + actorUserId: Long <<FK>>
  + passwordResetRecordId: Long <<FK>>
  + actionType: CredentialActionType
  + resultStatus: OperationResult
  + errorCode: String
  + errorMessage: Text
  + occurredAt: DateTime
}

class PasswordResetRecord {
  + passwordResetRecordId: Long <<PK>>
  + targetUserId: Long <<FK>>
  + requestedByUserId: Long <<FK>>
  + resetStatus: PasswordResetStatus
  + mustChangeAtNextLogin: Boolean
  + expiresAt: DateTime
  + requestedAt: DateTime
  + completedAt: DateTime
}

class AuditLog {
  + auditLogId: Long <<PK>>
  + actorUserId: Long <<FK>>
  + actorRole: UserType
  + featureCode: String
  + targetType: String
  + targetId: Long
  + actionType: AuditActionType
  + resultStatus: OperationResult
  + errorCode: String
  + errorMessage: Text
  + detail: Text
  + beforeData: JSON
  + afterData: JSON
  + requestId: String
  + occurredAt: DateTime
}

class ApplicationErrorLog {
  + applicationErrorLogId: Long <<PK>>
  + userId: Long <<FK>>
  + requestId: String
  + featureCode: String
  + operationName: String
  + errorCategory: ErrorCategory
  + errorCode: String
  + userMessage: Text
  + diagnosticDetail: Text
  + occurredAt: DateTime
}

class EvaluationRequest {
  + evaluationRequestId: Long <<PK>>
  + evaluationId: Long <<FK>>
  + modelId: String
  + promptVersion: String
  + rubricVersion: String
  + actorRole: UserType
  + consentStatusAtRequest: ConsentStatus
  + locale: String
  + requestPayload: JSON
  + requestStatus: RequestStatus
  + retryCount: Integer
  + requestedAt: DateTime
  + completedAt: DateTime
  + errorDetail: Text
}

class EvaluationResponse {
  + evaluationResponseId: Long <<PK>>
  + evaluationRequestId: Long <<FK>>
  + rawResponse: JSON
  + responseStatus: ResponseStatus
  + confidence: Decimal
  + warnings: JSON
  + receivedAt: DateTime
}

class EvaluationInputSnapshot {
  + inputSnapshotId: Long <<PK>>
  + evaluationRequestId: Long <<FK>>
  + anonymizedSubjectId: String
  + taskSnapshot: JSON
  + submissionSnapshot: JSON
  + logRangeStart: DateTime
  + logRangeEnd: DateTime
  + createdAt: DateTime
}

class EvaluationInputBuilder {
  + buildRequest(task: Task, rubric: Rubric, promptVersion: PromptVersion, logs: List<CodeLog>, submission: Submission, consent: ConsentRecord): EvaluationRequest
}

class CodeLog {
  + codeLogId: Long <<PK>>
  + participationId: Long <<FK>>
  + eventType: LogEventType
  + eventData: JSON
  + observedAt: DateTime
}

class Evaluation {
  + evaluationId: Long <<PK>>
  + submissionId: Long <<FK>>
  + evaluationStatus: EvaluationStatus
}

class Task {
  + taskId: Long <<PK>>
  + publicationStatus: PublicationStatus
}

class PromptVersion {
  + promptVersionId: Long <<PK>>
  + version: String
  + promptStatus: PromptStatus
}

class Rubric {
  + rubricId: Long <<PK>>
  + version: String
  + rubricStatus: RubricStatus
}

class Submission {
  + submissionId: Long <<PK>>
  + submissionStatus: SubmissionStatus
}

User "1" -- "0..*" ConsentRecord
User "0..1" -- "0..*" LoginHistory
ConsentDocumentVersion "1" -- "0..*" ConsentRecord
User "0..1" -- "0..*" CredentialHistory : 対象ユーザー
User "0..1" -- "0..*" CredentialHistory : 実行者
PasswordResetRecord "0..1" -- "0..*" CredentialHistory
User "1" -- "0..*" AuditLog : 操作者
User "0..1" -- "0..*" ApplicationErrorLog
Evaluation "1" -- "0..*" EvaluationRequest
EvaluationRequest "1" -- "0..*" EvaluationResponse
EvaluationRequest "1" -- "1" EvaluationInputSnapshot
User "1" -- "0..*" PasswordResetRecord : 対象アカウント
User "1" -- "0..*" PasswordResetRecord : 実行者
EvaluationInputBuilder ..> Task
EvaluationInputBuilder ..> PromptVersion
EvaluationInputBuilder ..> Rubric
EvaluationInputBuilder ..> Submission
EvaluationInputBuilder ..> CodeLog
EvaluationInputBuilder ..> ConsentRecord

note right of ConsentRecord
  同意状態と同意文書版はユーザー単位で記録し、
  AI送信時点の同意状態も要求履歴に固定する。
end note

note bottom of AuditLog
  教師/管理者の作成・更新・削除・公開・配信・
  再評価・CSV出力について実行者、対象、結果、差分を保持。
end note

@enduml
