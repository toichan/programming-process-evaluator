@startuml
!include <C4/C4_Context>

LAYOUT_LEFT_RIGHT()

title Programming Process Evaluator - System Context (Flow-centered)

Person(student, "生徒", "課題モードでPythonコードを編集・実行し提出する")
Person(teacher, "教師", "プロンプト設定と評価一覧確認を行う")

System_Boundary(system_boundary, "Programming Process Evaluator") {
  System(ppe, "Programming Process Evaluator", "Servlet/JSP + Java", "30秒ごとの編集ログ収集と生成AI評価を行う学習システム")
}

SystemDb(db, "MySQL", "ユーザー・課題・提出・コードログ・評価・履歴を保存")
System_Ext(ai_api, "Gemini API", "プロンプト・ルーブリック・コード編集ログをもとに評価を生成（JSON応答）")

Rel(teacher, ppe, "1. 教師が評価用プロンプトを設定\n主データ: task_id, prompt_version, rubric_version, common_prompt, ambiguity_item_instructions, evaluation_examples", "HTTPS")
Rel(student, ppe, "2. 生徒が課題を実施（コード編集・実行・提出）\n主データ: task_id, source_code, run_input, stdout, stderr, submitted_code, testcase_check_result", "HTTPS")
Rel(ppe, db, "2-補足. システムが編集ログを収集・保存\n主データ: snapshots(log_id,timestamp,source_code), run_events, save_events, submission, audit_log", "JDBC")

Rel(ppe, ai_api, "3. システムがGeminiへ送信\n主データ: meta(request_id, model_id, prompt_version, rubric_version), task, rubric, timeline_logs, submission, prompt_evaluation_settings", "API")
Rel(ai_api, ppe, "3-応答. 生成評価JSONを返却\n主データ: scores, reasons, process_analysis, confidence, evidence_refs, warnings", "API")
Rel(ppe, student, "4. システムが生成評価を生徒へ提示\n主データ: 2観点5段階評価, 観点別理由, プロセス分析要約", "HTTPS")
Rel(ppe, teacher, "5. システムが評価一覧を教師へ提示\n主データ: student_id, task_id, scores, evaluated_at, confidence, consent_status", "HTTPS")

@enduml
