# Paths only. Replace both SHA placeholders and the verified secret snapshot.
# No shell expansion, quoting, inline comments, passwords or API keys.
PPE_PROJECT=ppe-production
PPE_RELEASE=REPLACE_APP_COMMIT_SHA
PPE_DB_RELEASE=REPLACE_DB_COMMIT_SHA
PPE_DB_SOURCE_DIR=/var/lib/ppe/releases/REPLACE_DB_COMMIT_SHA/source
PPE_COMPOSE_FILE=/var/lib/ppe/releases/REPLACE_APP_COMMIT_SHA/source/compose.production.yml
PPE_SECRETS_DIR=/var/lib/ppe/secrets/REPLACE_VERIFIED_SNAPSHOT
PPE_TLS_DIR=/var/lib/ppe/tls-private/current
PPE_ACME_DIR=/var/lib/ppe/acme
PPE_CERTBOT_CONFIG_DIR=/var/lib/ppe/certbot/config
PPE_CERTBOT_WORK_DIR=/var/lib/ppe/certbot/work
PPE_CERTBOT_LOG_DIR=/var/lib/ppe/certbot/log
PPE_BIND_ADDRESS=0.0.0.0
PPE_HTTP_PORT=80
PPE_HTTPS_PORT=443
