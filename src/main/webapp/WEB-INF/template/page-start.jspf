<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" session="false" %>
<!doctype html>
<html lang="ja">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<title>Programming Process Evaluator<c:if test="${not empty screenPageTitle}"> - <c:out value="${screenPageTitle}"/></c:if></title>
	<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
		rel="stylesheet"
		integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB"
		crossorigin="anonymous">
	<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&amp;family=Noto+Sans+JP:wght@400;500;700&amp;display=swap"
		rel="stylesheet">
	<link href="${pageContext.request.contextPath}/css/template/template.css" rel="stylesheet">
	<link href="${pageContext.request.contextPath}/css/shared/feedback.css" rel="stylesheet">
	<c:if test="${screenDesign == 'teacher'}">
		<link href="${pageContext.request.contextPath}/css/teacher/shared/components.css?v=teacher-menu-v5" rel="stylesheet">
	</c:if>
	<c:if test="${screenDesign == 'teacher-login'}">
		<link href="${pageContext.request.contextPath}/css/teacher/account/login.css?v=prototype-match-1" rel="stylesheet">
	</c:if>
	<c:if test="${screenDesign == 'student'}">
		<link href="${pageContext.request.contextPath}/css/student/shared/components.css?v=help-modal" rel="stylesheet">
		<c:if test="${screenUsesCodeMirror}">
			<link href="https://cdn.jsdelivr.net/npm/codemirror@5.65.16/lib/codemirror.css" rel="stylesheet">
			<link href="https://cdn.jsdelivr.net/npm/codemirror@5.65.16/theme/material-darker.css" rel="stylesheet">
		</c:if>
	</c:if>
	<c:if test="${screenDesign == 'teacher' and screenUsesCodeMirror}">
		<link href="https://cdn.jsdelivr.net/npm/codemirror@5.65.16/lib/codemirror.css" rel="stylesheet">
		<link href="https://cdn.jsdelivr.net/npm/codemirror@5.65.16/theme/material-darker.css" rel="stylesheet">
	</c:if>
	<c:if test="${not empty screenStylesheet}">
		<link href="<c:url value='${screenStylesheet}'/>" rel="stylesheet">
	</c:if>
</head>
<body<c:choose><c:when test="${screenDesign == 'student'}"> class="student-screen"</c:when><c:when test="${screenDesign == 'teacher'}"> class="teacher-screen ${screenBodyClass}"</c:when><c:when test="${screenDesign == 'teacher-login'}"> class="teacher-login-screen"</c:when><c:when test="${screenDesign == 'admin'}"> class="admin-screen"</c:when></c:choose>>
	<c:choose>
		<c:when test="${screenDesign == 'teacher'}">
			<div class="teacher-app-shell">
				<%@ include file="/WEB-INF/teacher/shared/navigation.jspf" %>
		</c:when>
		<c:when test="${screenDesign == 'teacher-login'}">
		</c:when>
		<c:when test="${screenDesign == 'admin'}">
			<main class="py-4">
				<div class="container-fluid px-4">
		</c:when>
		<c:when test="${screenDesign != 'student'}">
			<main class="container py-5">
		</c:when>
	</c:choose>
