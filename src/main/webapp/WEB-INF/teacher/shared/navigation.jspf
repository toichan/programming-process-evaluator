<%@ page pageEncoding="UTF-8" %>
<nav id="teacherSidebar" class="teacher-sidebar bg-light border-end" aria-label="教師メニュー">
	<div class="sidebar-header">
		<h3 class="sidebar-title">メニュー</h3>
	</div>
	<ul class="sidebar-menu">
		<li class="sidebar-menu-item${teacherNavigationActiveItem == 'accounts' ? ' active' : ''}">
			<c:choose><c:when test="${teacherNavigationSummary.accountManagementEnabled}">
			<a class="sidebar-menu-link" href="<c:url value='/teacher/students'/>"
				aria-current="${teacherNavigationActiveItem == 'accounts' ? 'page' : 'false'}">
				<svg class="sidebar-icon" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/></svg>
				<span>生徒アカウント管理</span>
			</a>
			</c:when><c:otherwise>
			<button type="button" class="sidebar-menu-link is-disabled" aria-disabled="true" data-feature-allowed="false" title="生徒アカウント管理権限がありません">
				<svg class="sidebar-icon" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
					<path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
				</svg>
				<span>生徒アカウント管理</span>
			</button>
			</c:otherwise></c:choose>
		</li>
		<li class="sidebar-menu-item${teacherNavigationActiveItem == 'progress' ? ' active' : ''}">
			<c:choose>
				<c:when test="${teacherNavigationSummary.features.contains('task-progress')}">
					<a class="sidebar-menu-link" href="<c:url value='/teacher/progress'/>"
						aria-current="${teacherNavigationActiveItem == 'progress' ? 'page' : 'false'}">
						<svg class="sidebar-icon" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
							<path d="M9 11H7v2h2v-2zm4 0h-2v2h2v-2zm4 0h-2v2h2v-2zm2-7h-1V2h-2v2H8V2H6v2H5c-1.11 0-1.99.9-1.99 2L3 20c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 16H5V9h14v11z"/>
						</svg>
						<span>課題進捗確認</span>
					</a>
				</c:when>
				<c:otherwise>
					<button type="button" class="sidebar-menu-link is-disabled" aria-disabled="true"
						data-feature-allowed="false" title="課題進捗確認権限がありません">
						<svg class="sidebar-icon" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
							<path d="M9 11H7v2h2v-2zm4 0h-2v2h2v-2zm4 0h-2v2h2v-2zm2-7h-1V2h-2v2H8V2H6v2H5c-1.11 0-1.99.9-1.99 2L3 20c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 16H5V9h14v11z"/>
						</svg>
						<span>課題進捗確認</span>
					</button>
				</c:otherwise>
			</c:choose>
		</li>
		<li class="sidebar-menu-item${teacherNavigationActiveItem == 'exercise-review' ? ' active' : ''}">
			<c:choose><c:when test="${teacherNavigationSummary.features.contains('exercise-code-review')}">
			<a class="sidebar-menu-link" href="<c:url value='/teacher/exercises'/>"
				aria-current="${teacherNavigationActiveItem == 'exercise-review' ? 'page' : 'false'}">
				<svg class="sidebar-icon" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
					<path d="M8.59 16.59L4 12l4.59-4.59L10 8.82 6.83 12 10 15.18l-1.41 1.41zm6.82 0L14 15.18 17.17 12 14 8.82l1.41-1.41L20 12l-4.59 4.59z"/>
					<path d="M13.83 4h1.85l-5.5 16h-1.85l5.5-16z"/>
				</svg>
				<span>授業演習コード確認</span>
			</a>
			</c:when><c:otherwise>
			<button type="button" class="sidebar-menu-link is-disabled" aria-disabled="true"
				data-feature-allowed="false" title="授業演習コード確認権限がありません">授業演習コード確認</button>
			</c:otherwise></c:choose>
		</li>
		<li class="sidebar-menu-item${teacherNavigationActiveItem == 'distribution' ? ' active' : ''}">
			<c:choose>
				<c:when test="${teacherNavigationSummary.features.contains('code-distribution')}">
					<a class="sidebar-menu-link" href="<c:url value='/teacher/distribution'/>"
						aria-current="${teacherNavigationActiveItem == 'distribution' ? 'page' : 'false'}">
						<svg class="sidebar-icon" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
							<path d="M3 5a2 2 0 0 1 2-2h5.17a2 2 0 0 1 1.41.59l.83.82A2 2 0 0 0 13.83 5H19a2 2 0 0 1 2 2v2H3V5zm0 5h18v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-9zm9 2l-4 4h3v3h2v-3h3l-4-4z"/>
						</svg>
						<span>コード配信</span>
					</a>
				</c:when>
				<c:otherwise>
					<button type="button" class="sidebar-menu-link is-disabled" aria-disabled="true"
						data-feature-allowed="false" title="コード配信権限がありません">
						<svg class="sidebar-icon" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
							<path d="M3 5a2 2 0 0 1 2-2h5.17a2 2 0 0 1 1.41.59l.83.82A2 2 0 0 0 13.83 5H19a2 2 0 0 1 2 2v2H3V5zm0 5h18v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-9zm9 2l-4 4h3v3h2v-3h3l-4-4z"/>
						</svg>
						<span>コード配信</span>
					</button>
				</c:otherwise>
			</c:choose>
		</li>
		<li class="sidebar-menu-item${teacherNavigationActiveItem == 'submissions' ? ' active' : ''}">
			<c:choose><c:when test="${teacherNavigationSummary.features.contains('submission-review')}">
			<a class="sidebar-menu-link" href="<c:url value='/teacher/submissions'/>" aria-current="${teacherNavigationActiveItem == 'submissions' ? 'page' : 'false'}">
				<svg class="sidebar-icon" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
					<path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H5V8h14v11zM7 10h6v2H7v-2zm0 3h10v2H7v-2z"/>
					<path d="M14.5 5l-2.5 2.5L9.5 5H14.5z"/>
				</svg>
				<span>提出課題確認</span>
			</a>
			</c:when><c:otherwise><button type="button" class="sidebar-menu-link is-disabled" aria-disabled="true" data-feature-allowed="false">提出課題確認</button></c:otherwise></c:choose>
		</li>
		<li class="sidebar-menu-item${teacherNavigationActiveItem == 'evaluations' ? ' active' : ''}">
			<c:choose><c:when test="${teacherNavigationSummary.features.contains('evaluation-review')}">
			<a class="sidebar-menu-link" href="<c:url value='/teacher/evaluations'/>" aria-current="${teacherNavigationActiveItem == 'evaluations' ? 'page' : 'false'}">
				<svg class="sidebar-icon" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
					<path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>
				</svg>
				<span>評価確認</span>
			</a>
			</c:when><c:otherwise><button type="button" class="sidebar-menu-link is-disabled" aria-disabled="true" data-feature-allowed="false">評価確認</button></c:otherwise></c:choose>
		</li>
		<li class="sidebar-menu-item${teacherNavigationActiveItem == 'surveys' ? ' active' : ''}">
			<c:choose><c:when test="${teacherNavigationSummary.features.contains('survey-results')}">
			<a class="sidebar-menu-link" href="<c:url value='/teacher/surveys'/>" aria-current="${teacherNavigationActiveItem == 'surveys' ? 'page' : 'false'}">
				<svg class="sidebar-icon" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
					<path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-5 9h4v2h-4v-2zm0 4h4v2h-4v-2zM8 14h4v2H8v-2zm0-4h4v2H8v-2z"/>
				</svg>
				<span>アンケート結果確認</span>
			</a>
			</c:when><c:otherwise><button type="button" class="sidebar-menu-link is-disabled" aria-disabled="true" data-feature-allowed="false">アンケート結果確認</button></c:otherwise></c:choose>
		</li>
		<li class="sidebar-menu-item${teacherNavigationActiveItem == 'task' ? ' active' : ''}">
			<c:choose>
				<c:when test="${teacherNavigationSummary.taskManagementEnabled}">
					<a href="<c:url value='/teacher/task'/>" class="sidebar-menu-link"
						aria-current="${teacherNavigationActiveItem == 'task' ? 'page' : 'false'}">
						<svg class="sidebar-icon" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
							<path d="M19 3h-4.18C14.4 1.84 13.3 1 12 1s-2.4.84-2.82 2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-7-1c.55 0 1 .45 1 1h-2c0-.55.45-1 1-1zm7 17H5V5h14v14zm-2-10H7v2h10V9zm0 4H7v2h7v-2z"/>
						</svg>
						<span>課題編集</span>
					</a>
				</c:when>
				<c:otherwise>
					<button type="button" class="sidebar-menu-link is-disabled" aria-disabled="true" data-feature-allowed="false" title="課題編集権限がありません">
						<svg class="sidebar-icon" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
							<path d="M19 3h-4.18C14.4 1.84 13.3 1 12 1s-2.4.84-2.82 2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-7-1c.55 0 1 .45 1 1h-2c0-.55.45-1 1-1zm7 17H5V5h14v14zm-2-10H7v2h10V9zm0 4H7v2h7v-2z"/>
						</svg>
						<span>課題編集</span>
					</button>
				</c:otherwise>
			</c:choose>
		</li>
		<li class="sidebar-menu-item${teacherNavigationActiveItem == 'prompt' ? ' active' : ''}">
			<c:choose>
				<c:when test="${teacherNavigationSummary.promptDesignEnabled}">
					<a href="<c:url value='/teacher/prompt'/>" class="sidebar-menu-link"
						aria-current="${teacherNavigationActiveItem == 'prompt' ? 'page' : 'false'}">
						<svg class="sidebar-icon" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
							<path d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zm14.71-9.04c.39-.39.39-1.02 0-1.41l-2.5-2.5a.996.996 0 0 0-1.41 0l-1.83 1.83 3.75 3.75 1.99-1.83z"/>
						</svg>
						<span>プロンプト設計</span>
					</a>
				</c:when>
				<c:otherwise>
					<button type="button" class="sidebar-menu-link is-disabled" aria-disabled="true" data-feature-allowed="false" title="プロンプト設計権限がありません">
						<svg class="sidebar-icon" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
							<path d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zm14.71-9.04c.39-.39.39-1.02 0-1.41l-2.5-2.5a.996.996 0 0 0-1.41 0l-1.83 1.83 3.75 3.75 1.99-1.83z"/>
						</svg>
						<span>プロンプト設計</span>
					</button>
				</c:otherwise>
			</c:choose>
		</li>
	</ul>
</nav>
<div class="teacher-main">
	<header class="teacher-header bg-white border-bottom">
		<div class="container-fluid h-100 d-flex align-items-center justify-content-between px-4">
			<button type="button" class="teacher-nav-toggle" aria-controls="teacherSidebar" aria-expanded="false" aria-label="メニューを開く">
				<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
					<path d="M4 6h16M4 12h16M4 18h16"/>
				</svg>
			</button>
			<div class="header-logo d-flex align-items-center">
				<svg class="header-logo-icon" width="32" height="32" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
					<path d="M4 4.5C4 3.67 4.67 3 5.5 3h13c.83 0 1.5.67 1.5 1.5v15c0 .83-.67 1.5-1.5 1.5h-13A1.5 1.5 0 0 1 4 19.5v-15zM5.5 4a.5.5 0 0 0-.5.5V8h15V4.5a.5.5 0 0 0-.5-.5h-14zM5 9v10.5c0 .28.22.5.5.5h13a.5.5 0 0 0 .5-.5V9H5z"/>
					<path d="M8.75 13.5L7.25 12l1.5-1.5m6.5 3L16.75 12l-1.5-1.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
					<path d="M11 13.5h2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
				</svg>
				<h2 class="mb-0">Programming Process Evaluator</h2>
			</div>
			<div class="header-actions d-flex align-items-center gap-3">
				<div class="teacher-info">
					<div class="teacher-info-item">
						<svg class="teacher-info-icon" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
							<path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
						</svg>
						<span class="teacher-info-text">教師ID: <c:out value="${teacherId}"/></span>
						<svg class="teacher-info-icon" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
							<path d="M5 3v18h14V3H5zm6 2h2v2h-2V5zM7 9h2v2H7V9zm4 0h2v2h-2V9zm4 0h2v2h-2V9zM7 13h2v2H7v-2zm4 0h2v2h-2v-2zm4 0h2v2h-2v-2zM10 17h4v4h-4v-4z"/>
						</svg>
						<span class="teacher-info-text">学校:
							<c:choose>
								<c:when test="${not empty teacherNavigationSummary.schools}">
									<c:forEach var="school" items="${teacherNavigationSummary.schools}" varStatus="status"><c:if test="${status.index > 0}">, </c:if><c:out value="${school.name}"/></c:forEach>
								</c:when>
								<c:otherwise>割り当てなし</c:otherwise>
							</c:choose>
						</span>
					</div>
				</div>
				<a class="btn btn-sm btn-outline-primary" href="<c:url value='/teacher/account'/>">アカウント</a>
				<form method="post" action="<c:url value='/auth/logout'/>">
					<input type="hidden" name="csrfToken" value="<c:out value='${csrfToken}'/>">
					<button class="btn btn-sm btn-outline-secondary" type="submit">ログアウト</button>
				</form>
			</div>
		</div>
	</header>
	<main class="teacher-page-content">
