<%@ page pageEncoding="UTF-8" %>
<div class="modal fade rubric-modal" id="rubricModal" tabindex="-1" aria-labelledby="rubricModalLabel"
	aria-hidden="true" data-rubric-url="<c:url value='/student/rubric'/>">
	<div class="modal-dialog modal-fullscreen modal-dialog-scrollable">
		<div class="modal-content">
			<div class="modal-header">
				<div class="rubric-header-brand">
					<div class="rubric-header-icon" aria-hidden="true">
						<svg width="18" height="18" viewBox="0 0 16 16" fill="currentColor">
							<path d="M4 .5A1.5 1.5 0 0 0 2.5 2v12A1.5 1.5 0 0 0 4 15.5h8a1.5 1.5 0 0 0 1.5-1.5V2A1.5 1.5 0 0 0 12.5.5h-8zM4 1.5h8a.5.5 0 0 1 .5.5v12a.5.5 0 0 1-.5.5H4a.5.5 0 0 1-.5-.5V2a.5.5 0 0 1 .5-.5z"/>
							<path d="M5 4.5h6v1H5v-1zm0 2.5h6v1H5v-1zm0 2.5h4v1H5v-1z"/>
						</svg>
					</div>
					<div class="rubric-header-copy">
						<div class="rubric-header-kicker">標準ルーブリック · 0805</div>
						<h2 class="modal-title h4 mb-1" id="rubricModalLabel">ルーブリック</h2>
					</div>
				</div>
				<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="閉じる"></button>
			</div>
			<div class="modal-body py-4">
				<div class="container-fluid">
					<div id="rubricFeedback" aria-live="polite"></div>
					<p id="rubricLoading" role="status" hidden>ルーブリックを読み込んでいます。</p>
					<div id="rubricContent"></div>
					<button id="rubricRetry" type="button" class="btn btn-outline-primary" hidden>再読み込み</button>
				</div>
			</div>
		</div>
	</div>
</div>
